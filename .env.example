# Copy to `.env` (git-ignored) and adjust. Compose reads this file for
# ${VARIABLES} automatically; `docker compose up -d` then picks them up.
#
# Nothing here is required for a local trial: with an empty file the app starts
# on http://127.0.0.1:8000, creates an `admin` account and logs a random
# password once (docker compose logs app). Reminders are written to out/mail.

# --- host ---------------------------------------------------------------
# Loopback host port only. The container still listens on 8000 internally.
BG_WEB_PORT=8000

# --- first account ------------------------------------------------------
# Leave the password empty to get a generated one in the log.
BG_BOOTSTRAP_ADMIN_USER=admin
BG_BOOTSTRAP_ADMIN_PASS=
BG_BOOTSTRAP_ADMIN_EMAIL=

# --- sessions -----------------------------------------------------------
BG_SESSION_MINUTES=30
# Keep 0 for plain-HTTP loopback. Set 1 only behind HTTPS.
BG_COOKIE_SECURE=0

# --- OCR ----------------------------------------------------------------
# indra (default) | tesseract | both. The comparison is per field and page,
# not "the engine that filled the most boxes wins".
BG_OCR_ENGINE=indra
BG_OCR_DPI=300
BG_INDRA_THREADS=4
BG_INDRA_MODE=auto

# Optional Azure Document Intelligence test engine. Azure receives the PDF
# bytes when Azure or All engines are selected in the upload UI.
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=replace-with-key-1
AZURE_DI_KEY_2=replace-with-key-2
AZURE_DI_MODEL=prebuilt-layout
# F0-safe limits; set up to 2000 pages and 500 MB only if using S0.
AZURE_DI_PAGE_BATCH_SIZE=2
AZURE_DI_MAX_BYTES=3800000
# Docker Compose persists Hugging Face downloads under ./data/huggingface.

# --- T-7 reminders ------------------------------------------------------
# Empty host => dry run: one .eml per message under out/mail/.
BG_SMTP_HOST=
BG_SMTP_PORT=587
BG_SMTP_USER=
BG_SMTP_PASS=
BG_MAIL_FROM=bg-automation@localhost
BG_MAIL_FROM_NAME=BG Automation
# 1 keeps dry-run even when an SMTP host is set. Set 0 to really send.
BG_MAIL_DRY_RUN=1
# Comma-separated distribution lists.
BG_FINANCE_DL=
BG_USER_TEAM_DL=
BG_REMINDER_DAYS=7
BG_APP_URL=http://127.0.0.1:8000

# --- scheduler ----------------------------------------------------------
BG_SCHEDULER=1
BG_SCHEDULER_TIME=09:00
# When set, POST /internal/daily-reminder needs X-Internal-Token: <value>.
BG_INTERNAL_TOKEN=

# --- official-name lookup (optional) ------------------------------------
# Firecrawl agent checks the OCR'd Bank Name and Name of Contractor against the
# web and offers official Indian names in the review dropdown. Only those two
# strings and any IFSC codes leave the machine - never the PDF, amounts or
# dates. Leave the key empty to switch it off (the app stays fully local).
BG_FIRECRAWL_API_KEY=
# 0 switches lookups off even when a key is present.
BG_LOOKUP=1
# Seconds to wait for one PDF's two lookups before keeping the OCR values.
BG_LOOKUP_TIMEOUT=120
# Per-agent-job credit cap (the API default is 2500; keep this small).
BG_LOOKUP_MAX_CREDITS=100
# Reuse answers for identical text for this many days.
BG_LOOKUP_TTL_DAYS=30
BG_LOOKUP_MAX_MATCHES=5
