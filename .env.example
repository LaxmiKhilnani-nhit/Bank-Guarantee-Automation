# Copy to `.env` (git-ignored) and adjust. Compose reads this file for
# ${VARIABLES} automatically, and `python -m bgauto.web` / the CLI load it too,
# so the same file works for Docker and a local run. Real environment variables
# win over values in this file.
#
# Nothing here is required for a local trial: with an empty file the app starts
# on http://127.0.0.1:8000, creates an `admin` account and logs a random
# password once (docker compose logs app). Reminders are written to out/mail.

# --- host ---------------------------------------------------------------
# Loopback host port only. The container still listens on 8000 internally.
BG_WEB_PORT=8000

# --- first account ------------------------------------------------------
# Leave the password empty to get a generated one in the log.
BG_BOOTSTRAP_ADMIN_USER=admin
BG_BOOTSTRAP_ADMIN_PASS=
BG_BOOTSTRAP_ADMIN_EMAIL=

# --- sessions -----------------------------------------------------------
BG_SESSION_MINUTES=30
# Keep 0 for plain-HTTP loopback. Set 1 only behind HTTPS.
BG_COOKIE_SECURE=0

# --- Datalab (convert -> extract pipeline) ------------------------------
# Every uploaded PDF is sent to the Datalab pipeline. The key stays in this
# git-ignored file; never commit it or paste it into source or logs.
# Create a key at https://www.datalab.to/app/keys (or run `datalab login`).
DATALAB_API_KEY=
# lite | fast | balanced | accurate. Only used by ocr.convert_pdf (reference
# and tests); pipeline runs take their parse mode from the pipeline's convert step.
BG_DATALAB_MODE=fast
# Base URL and polling limits for large or slow documents (seconds).
BG_DATALAB_BASE_URL=https://www.datalab.to
BG_DATALAB_TIMEOUT=600
BG_DATALAB_MAX_POLLS=300
BG_DATALAB_POLL_INTERVAL=2

# --- Datalab pipeline (convert -> extract) ------------------------------
# The pipeline owns the extraction schema and the convert/extract settings.
# The production pipeline is deployed on a fresh account, so its first
# published version is 1. Pin it so a manual edit cannot silently change
# results; leave BG_DATALAB_PIPELINE_VERSION empty to follow the active version.
# While testing on the development account, that pipeline publishes the same
# schema as version 3; use 3 (or leave empty) locally.
# Replace the id with the one created on the production account.
BG_DATALAB_PIPELINE_ID=pl_INVNggnY7MaE
BG_DATALAB_PIPELINE_VERSION=1
# Informational only: the extract mode is stored in the pipeline. Reported by
# /api/health so an operator can confirm which pipeline release is pinned.
BG_DATALAB_EXTRACTION_MODE=turbo

# --- T-7 reminders ------------------------------------------------------
# Empty host => dry run: one .eml per message under out/mail/.
BG_SMTP_HOST=
BG_SMTP_PORT=587
BG_SMTP_USER=
BG_SMTP_PASS=
BG_MAIL_FROM=bg-automation@localhost
BG_MAIL_FROM_NAME=BG Automation
# 1 keeps dry-run even when an SMTP host is set. Set 0 to really send.
BG_MAIL_DRY_RUN=1
# Comma-separated distribution lists.
BG_FINANCE_DL=
BG_USER_TEAM_DL=
BG_REMINDER_DAYS=7
BG_APP_URL=http://127.0.0.1:8000

# --- scheduler ----------------------------------------------------------
BG_SCHEDULER=1
BG_SCHEDULER_TIME=09:00
# When set, POST /internal/daily-reminder needs X-Internal-Token: <value>.
BG_INTERNAL_TOKEN=

# --- official-name lookup (optional) ------------------------------------
# Firecrawl agent checks the OCR'd Bank Name and Name of Contractor against the
# web and offers official Indian names in the review dropdown. Only those two
# strings and any IFSC codes leave the machine - never the PDF, amounts or
# dates. Leave the key empty to switch the lookup off.
BG_FIRECRAWL_API_KEY=
# 0 switches lookups off even when a key is present.
BG_LOOKUP=1
# Seconds to wait for one PDF's two lookups before keeping the OCR values.
BG_LOOKUP_TIMEOUT=120
# Per-agent-job credit cap (the API default is 2500; keep this small).
BG_LOOKUP_MAX_CREDITS=100
# Reuse answers for identical text for this many days.
BG_LOOKUP_TTL_DAYS=30
BG_LOOKUP_MAX_MATCHES=5
